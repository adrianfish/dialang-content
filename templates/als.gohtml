<div id="large-logo-wrapper">
  <img src="{{.BaseAssetsUrl}}/images/dlogo_large_dark.gif"/>
</div>
<form id="als-form">
  <select id="al-dropdown" name="al">
    {{range .Languages}}
    <option value="{{.Locale}}">{{.Description}}</option>
    {{end}}
  </select>
  <button type="button" id="al-button">Select Language</button>
</form>
<br />
<br />
<div id="funder">{{.Fundermessage}}</div>
<script src="/js/als.js"></script>
