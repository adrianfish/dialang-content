				<script>
					var saveDialogTitle = "{{.saveDialogTitle}}";
				</script>
                <h1 id="tls-title">{{.tlsTitle}}</h1>

                <div id="resume-test-block">
                  <div id="resume-test-instruction">
                    If you have a save token from a partially completed test, you can enter it here
                    and resume your test. Otherwise, just select a test language and skill from
                    the grid below
                  </div>
                  <input type="text" id="save-token-field" placeholder="Enter your save token"/>
                  <button type="button" id="resume-test-button">Resume Test</button>
                </div>

                <table id="tls-table" cols="6">
                    <thead>
                        <tr>
                            <th></th>
                            <th><img src="{{.baseAssetsUrl}}/images/listening.gif" title="{{.listeningTooltip}}"/></th>
                            <th><img src="{{.baseAssetsUrl}}/images/writing.gif" title="{{.writingTooltip}}"/></th>
                            <th><img src="{{.baseAssetsUrl}}/images/reading.gif" title="{{.readingTooltip}}"/></th>
                            <th><img src="{{.baseAssetsUrl}}/images/hammer.gif" title="{{.structuresTooltip}}"/></th>
                            <th><img src="{{.baseAssetsUrl}}/images/book.gif" title="{{.vocabularyTooltip}}"/></th>
                        </tr>
                    </thead>
                    <tbody>
                        {{range .testrows}}
                        <tr>
                            <td class="language-column">{{.languageName}}</td>
                            <td class="language-skill-column"><a href="javascript:;" class="tls-link" title="{{.languageName}}, {{$.listeningTooltip}}" tl="{{.languageCode}}" skill="listening" calibrated="{{.listeningcalibrated}}"><img src="{{$.baseAssetsUrl}}/images/available.gif"/></a></td>
                            <td class="language-skill-column"><a href="javascript:;" class="tls-link" title="{{.languageName}}, {{$.writingTooltip}}" tl="{{.languageCode}}" skill="writing" calibrated="{{.writingcalibrated}}"><img src="{{$.baseAssetsUrl}}/images/available.gif"/></a></td>
                            <td class="language-skill-column"><a href="javascript:;" class="tls-link" title="{{.languageName}}, {{$.readingTooltip}}" tl="{{.languageCode}}" skill="reading" calibrated="{{.readingcalibrated}}"><img src="{{$.baseAssetsUrl}}/images/available.gif"/></a></td>
                            <td class="language-skill-column"><a href="javascript:;" class="tls-link" title="{{.languageName}}, {{$.structuresTooltip}}" tl="{{.languageCode}}" skill="structures" calibrated="{{.structurescalibrated}}"><img src="{{$.baseAssetsUrl}}/images/available.gif"/></a></td>
                            <td class="language-skill-column"><a href="javascript:;" class="tls-link" title="{{.languageName}}, {{$.vocabularyTooltip}}" tl="{{.languageCode}}" skill="vocabulary" calibrated="{{.vocabularycalibrated}}"><img src="{{$.baseAssetsUrl}}/images/available.gif"/></a></td>
                        </tr>
                        {{end}}
                    </tbody>
                </table>

                <div id="tls-legend">
                    <div><img src="{{.baseAssetsUrl}}/images/done.gif" /></div><div>{{.done}}</div>
                    <div><img src="{{.baseAssetsUrl}}/images/available.gif" /></div><div>{{.available}}</div>
                    <div><img src="{{.baseAssetsUrl}}/images/notavailable.gif" /></div><div>{{.notavailable}}</div>
                </div>

                <div id="disclaimer-dialog" title="{{.disclaimerTitle}}">
                    <div class="dialang-dialog-content">
                        <div id="disclaimer-text">{{.disclaimer}}</div>
                        <div class="dialog-button-panel"><button id="disclaimer-button"><img src="{{.baseAssetsUrl}}/images/yes.gif"/></button><br />{{.ok}}</div>
                    </div>
                </div> <!-- /disclaimer-dialog -->

                <div id="confirm-dialog" title="{{.confirmationTitle}}" class="dialang-dialog">
                    <div class="dialang-dialog-content">
                        <p>{{.testChosen}}</p>
                        <p id="confirmation_langskill"></p>
                        <div id="confirmation-button-table">
                            <div>
                                <div align="center"><button id="confirm-yes"><img src="{{.baseAssetsUrl}}/images/yes.gif"/></button></div>
                                <div align="center"><button id="confirm-no"><img src="{{.baseAssetsUrl}}/images/no.gif" width="58" height="58"/></button></div>
                            </div>
                            <div>
                                <div align="center">{{.yes}}</div><div align="center">{{.no}}</div>
                            </div>
                        </div>
                    </div>
                </div> <!-- /confirmation-dialog -->
