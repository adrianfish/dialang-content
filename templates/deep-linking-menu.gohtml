<form action="/api/builddeeplinks" method="POST">
  <h1 id="tls-title">{{.tlsTitle}}</h1>
  <table id="tls-table" cols="6">
    <thead>
      <tr>
        <th></th>
        <th><img src="{{.baseAssetsUrl}}/images/listening.gif" title="{{.listeningTooltip}}"/></th>
        <th><img src="{{.baseAssetsUrl}}/images/writing.gif" title="{{.writingTooltip}}"/></th>
        <th><img src="{{.baseAssetsUrl}}/images/reading.gif" title="{{.readingTooltip}}"/></th>
        <th><img src="{{.baseAssetsUrl}}/images/hammer.gif" title="{{.structuresTooltip}}"/></th>
        <th><img src="{{.baseAssetsUrl}}/images/book.gif" title="{{.vocabularyTooltip}}"/></th>
      </tr>
    </thead>
    <tbody>
      {{range .testrows}}
      <tr>
        <td class="language-column">{{.languageName}}</td>
        <td class="language-skill-column"><input type="radio" name="tls" value="{{.languageCode}}#listening" title="{{.languageName}}, {{$.listeningTooltip}}" /></td>
        <td class="language-skill-column"><input type="radio" name="tls" value="{{.languageCode}}#writing" title="{{.languageName}}, {{$.writingTooltip}}" /></td>
        <td class="language-skill-column"><input type="radio" name="tls" value="{{.languageCode}}#reading" title="{{.languageName}}, {{$.readingTooltip}}" /></td>
        <td class="language-skill-column"><input type="radio" name="tls" value="{{.languageCode}}#structures" title="{{.languageName}}, {{$.structuresTooltip}}" /></td>
        <td class="language-skill-column"><input type="radio" name="tls" value="{{.languageCode}}#vocabulary" title="{{.languageName}}, {{$.vocabularyTooltip}}" /></td>
      </tr>
      {{end}}
    </tbody>
  </table>
  <input type="hidden" name="platformCode" value="${platformCode}" />
  <input type="hidden" name="contextId" value="${contextId}" />
  <input type="hidden" name="userId" value="${user}" />
  <input type="hidden" name="al" value="{{.al}}" />
  <button>Select</button>
</form>
