<div id="media">
<audio id="audio" preload="auto">
    <source src="/media/audio/{{.filename}}.mp3" type="audio/mpeg">
    <source src="/media/audio/{{.filename}}.ogg" type="audio/ogg">
    <p>Your browser does not support the <code>audio</code> element.</p>
</audio>
<button id="playaudio" disabled><img src="/images/SpkNotPressed.gif" /></button>
<script src="/js/audiomedia.js"></script>
</div> <!-- /media -->
